{
  "name": "@tsunamaru/pi-powershell",
  "version": "1.0.0",
  "description": "Maintained fork of marcfargas/pi-powershell with current Pi support",
  "author": "tsunamaru",
  "license": "MIT",
  "type": "module",
  "contributors": [
    {
      "name": "Marc Fargas",
      "url": "https://github.com/marcfargas"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsunamaru/pi-powershell.git"
  },
  "bugs": {
    "url": "https://github.com/tsunamaru/pi-powershell/issues"
  },
  "homepage": "https://github.com/tsunamaru/pi-powershell#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi",
    "pi-package",
    "agent",
    "powershell",
    "windows",
    "background-processes",
    "system-integration"
  ],
  "files": [
    "src/**/*.ts",
    "skills/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.78.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ __tests__/"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  }
}
